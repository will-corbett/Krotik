{
  "name": "krotik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Instant-drill practice for Russian verb forms, aspect, agreement and motion verbs.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "data:fetch": "tsx scripts/fetch.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data": "npm run data:fetch && npm run data:build",
    "data:verify-overrides": "tsx scripts/verify-overrides.ts",
    "links:check": "tsx scripts/check-links.ts",
    "audio:fetch": "tsx scripts/fetch-audio.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unbzip2-stream": "^1.4.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0"
  }
}
